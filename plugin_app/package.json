{
  "name": "plugin_app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start-wireless.ps1",
    "wireless": "powershell -ExecutionPolicy Bypass -File scripts/start-wireless.ps1",
    "wireless:env": "powershell -ExecutionPolicy Bypass -File scripts/setup-wireless.ps1",
    "expo:wired": "powershell -ExecutionPolicy Bypass -File scripts/start-wireless.ps1 -Usb",
    "android:wireless": "powershell -ExecutionPolicy Bypass -File scripts/install-local-android.ps1",
    "android:wired": "powershell -ExecutionPolicy Bypass -File scripts/install-local-android.ps1 -Usb",
    "android": "expo run:android",
    "android:release": "powershell -ExecutionPolicy Bypass -File android/build-release-offline.ps1",
    "android:update": "powershell -ExecutionPolicy Bypass -File scripts/install-local-android.ps1 -Usb",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node scripts/security-check.cjs",
    "security:release": "node scripts/security-check.cjs --release"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "16.1.2",
    "expo": "54.0.37",
    "expo-auth-session": "7.0.11",
    "expo-constants": "18.0.14",
    "expo-file-system": "19.0.24",
    "expo-font": "14.0.12",
    "expo-linear-gradient": "15.0.8",
    "expo-location": "19.0.8",
    "expo-notifications": "0.32.17",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "3.0.9",
    "expo-task-manager": "57.0.16",
    "expo-web-browser": "15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-razorpay": "3.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "babel-preset-expo": "54.0.11"
  }
}
