EXPO_PUBLIC_API_PORT=8091
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# Use this for fixed/staging servers. Leave blank for local wireless testing.
# EXPO_PUBLIC_API_BASE_URL=http://YOUR_PC_LAN_IP:8091/api

# Local wireless testing uses this. Run `npm run wireless:env` to update it automatically.
# EXPO_PUBLIC_API_LAN_BASE_URL=http://YOUR_PC_LAN_IP:8091/api

# Android debug builds use this to load Metro over Wi-Fi instead of USB/localhost.
# EXPO_PUBLIC_METRO_HOST=YOUR_PC_LAN_IP:8081
