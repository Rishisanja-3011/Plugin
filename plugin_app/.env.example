EXPO_PUBLIC_API_PORT=8091
EXPO_PUBLIC_API_TIMEOUT_MS=10000
EXPO_PUBLIC_OTP_TIMEOUT_MS=15000
EXPO_PUBLIC_PAYMENT_TIMEOUT_MS=20000
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_restricted_android_and_directions_api_key

# Required for release builds. It must be one HTTPS origin with no embedded credentials.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api

# Local wireless testing uses this. Run `npm run wireless:env` to update it automatically.
# EXPO_PUBLIC_API_LAN_BASE_URL=http://YOUR_PC_LAN_IP:8091/api

# Android debug builds use this to load Metro over Wi-Fi instead of USB/localhost.
# EXPO_PUBLIC_METRO_HOST=YOUR_PC_LAN_IP:8081

# Release signing values belong in the CI secret store or local process environment.
# Never commit a real keystore or any real password.
PLUGIN_RELEASE_STORE_FILE=C:\secure\plugin-release.keystore
PLUGIN_RELEASE_STORE_PASSWORD=
PLUGIN_RELEASE_KEY_ALIAS=
PLUGIN_RELEASE_KEY_PASSWORD=
